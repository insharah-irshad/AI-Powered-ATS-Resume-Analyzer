    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a professional career report formatter.\n\nConvert the ATS analysis into a clean recruiter-friendly report.\nReport Date: {{ $('Get Current Date').item.json.report_date }}\nCreate a structured report with:\n\n1. Candidate ATS Score\n2. Strong Matches\n3. Missing Skills\n4. Skill Gap Analysis\n5. Resume Improvement Recommendations\n6. Interview Preparation Points\n\nRules:\n- Keep the report concise and professional.\n- Do not add information that is not present.\n- Make it suitable for sharing with recruiters.\n\nATS Analysis:\n\n{{$json[\"output\"]}}",
        "options": {}
      },
